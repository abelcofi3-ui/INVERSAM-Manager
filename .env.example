# Copie este archivo a .env.local y complete los valores de su proyecto Supabase
# (Supabase → Project Settings → API).

# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública "anon" (segura para el navegador; la seguridad la aplica RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role": SOLO servidor. Necesaria para crear usuarios y cambiar contraseñas
# desde el módulo Usuarios y para `npm run create-admin`. Nunca la exponga en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
